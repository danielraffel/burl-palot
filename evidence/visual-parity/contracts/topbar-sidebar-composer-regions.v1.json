  "gates": [
    {
      "id": "desktop_main_full_extent",
      "requirement": "The main imported root reaches the viewport right and bottom edges at the desktop reference size.",
      "expected": {"right": 1200, "bottom": 800},
      "native_current": {"right": 1188, "bottom": 788},
      "status": "fail"
    },
    {
      "id": "sidebar_toggle_fixed_slot",
      "requirement": "The sidebar toggle remains in the same reserved toolbar slot in expanded, collapsed, and responsive states.",
