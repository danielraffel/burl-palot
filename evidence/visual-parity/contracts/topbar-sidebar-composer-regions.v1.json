      "observed_expanded_source": [93, 8, 28, 28],
      "observed_expanded_native": [93, 8, 28, 28],
      "observed_narrow_native": [93, 8, 28, 28],
      "observed_collapsed_native": null,
      "status": "fail_missing_post_interaction_evidence"
    },
    {
      "id": "sidebar_toggle_title_non_overlap",
      "requirement": "After sidebar collapse, visible breadcrumb/title rectangles must not intersect the reserved sidebar-toggle rectangle.",
      "expected": {"intersection_area": 0, "minimum_gap": 0},
      "status": "red_unevaluable",
      "reason": "No native post-click visual state exists, and the stored collapsed Electron screenshot and geometry JSON disagree about the main-panel position. A fresh source capture pair is required before exact collapsed-state bounds can be frozen."
    },
    {
      "id": "composer_right_bottom_anchor",
      "requirement": "At 1200x800 the composer and its footer preserve source right and bottom anchors while the window resizes.",
      "expected": {"composer_right": 1183, "footer_bottom": 784},
      "native_current": {"composer_right": 1171, "footer_bottom": 772},
      "status": "fail"
    },
    {
      "id": "model_measurement_consistency",
      "requirement": "Measured text height must fit its allocated node and match the source visual line count at each breakpoint.",
      "desktop": {"allocated_height": 18, "measured_height": 36, "status": "fail"},
      "narrow": {"source_visual_lines": 2, "native_visual_lines": 3, "status": "fail"},
      "status": "fail"
    },
    {
      "id": "footer_baseline_group",
      "requirement": "Local, escape, and interrupt text share a visual baseline; source internal KBD padding and border are preserved.",
