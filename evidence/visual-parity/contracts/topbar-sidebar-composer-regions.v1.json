  "capture_requirements": {
    "states": [
      "desktop-expanded",
      "desktop-collapsed-post-click",
      "desktop-composer-model-menu-open",
      "desktop-status-default-hover-pressed",
      "narrow-expanded"
    ],
    "each_state_must_include": [
      "source_png",
      "source_geometry_json",
      "native_png",
      "native_layout_json",
      "interaction_receipt",
      "freshness_manifest"
    ],
    "rule": "A state is not green when the action receipt changes but the imported visual tree and screenshot do not change as required."
